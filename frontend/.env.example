# The backend serves this dashboard and every API on ONE port (8050):
#   npm run build   ->  open http://localhost:8050
# Nothing to set here for that.

# Only for `npm run dev` (live reload while developing): where the backend runs.
DEV_BACKEND_URL=http://127.0.0.1:5074
VITE_DEV_PORT=5180
VITE_API_BASE_URL=https://backend.intelligence.extrahand.in
