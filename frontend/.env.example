# =============================================================================
# ExtraHand Intelligence Platform - Frontend
# =============================================================================
# The backend serves this dashboard and every API on ONE port (8050):
#   npm run build   ->  open http://localhost:8050
# Nothing to set here for that.

# Only for `npm run dev` (live reload while developing): where the backend runs.
DEV_BACKEND_URL=http://127.0.0.1:5074
VITE_DEV_PORT=3074
# VITE_API_BASE_URL is left empty on purpose: the dashboard calls /api on its own address
# (npm run dev forwards it to DEV_BACKEND_URL; on the server the frontend's nginx forwards it to the backend).
