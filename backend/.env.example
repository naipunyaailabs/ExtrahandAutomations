# ---------------------------------------------------------------------------
# Intelligence Platform - backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Defaults to SQLite at backend/database/intelligence.db.
# Any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db)
# DATABASE_URL=

# --- ExtraHand data source --------------------------------------------------
# mock = built-in demo data (no credentials needed)
# live = real ExtraHand APIs from Doc/data.docx
EXTRAHAND_MODE=mock
EXTRAHAND_MAIN_BASE_URL=https://extrahand-main-admin-server.backend.extrahand.in/api/v1
EXTRAHAND_TASK_BASE_URL=https://extrahand-task-service.backend.extrahand.in
EXTRAHAND_EMAIL=
EXTRAHAND_PASSWORD=
EXTRAHAND_DASHBOARD_TYPE=main_admin
EXTRAHAND_POSTED_BY=team

# Matching-candidates route on the Task Service needs internal service auth
# (X-Service-Auth / X-User-Id). Leave empty to fall back to the helper list + local
# location/service filtering.
EXTRAHAND_SERVICE_AUTH=
EXTRAHAND_SERVICE_USER_ID=
# Role value used for the helper list fallback (GET /users?role=...)
EXTRAHAND_HELPER_ROLE=helper

# POST /tasks/{id}/assign changes live data and may notify people.
# Keep false until the backend team approves; acceptances are still recorded locally.
EXTRAHAND_ALLOW_ASSIGNMENT=false
# Use mock data when live ExtraHand is unreachable. Keep false: mock rows would be saved as real tickets / helpers
EXTRAHAND_MOCK_FALLBACK=false

# --- Matching ---------------------------------------------------------------
MATCH_RADIUS_KM=50
MAX_HELPERS_PER_TICKET=10

# --- Telephony --------------------------------------------------------------
# simulator = calls are answered from the dashboard (for demos/testing)
# twilio    = real phone calls with keypad input
TELEPHONY_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL of this backend that Twilio can reach (e.g. an ngrok URL)
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true
TTS_VOICE=Polly.Aditi
TTS_LANGUAGE=en-IN

# Times the task message is played when the helper presses nothing, before hanging up
IVR_MAX_PROMPTS=3
IVR_GATHER_TIMEOUT_SECONDS=7
CALL_RING_TIMEOUT_SECONDS=30
# A call with no final status after this long is treated as failed and the next helper is tried
CALL_STALE_MINUTES=10

# --- Scheduling -------------------------------------------------------------
# Follow-up reminder calls before the task starts (minutes)
FOLLOWUP_OFFSETS_MINUTES=60
SYNC_INTERVAL_SECONDS=300
WORKER_TICK_SECONDS=10
# Automatically start calling helpers for new unassigned tickets after each sync
AUTO_DISPATCH=false
# Defaults for the Settings page (editable there at runtime)
CALLING_HOURS_START=09:00
CALLING_HOURS_END=21:00
FEEDBACK_CALL_DELAY_MINUTES=15
MAX_HELPER_CALL_ATTEMPTS=3
COST_PER_CALL_MINUTE=0.50
COST_PER_WHATSAPP_MSG=0.25

# --- WhatsApp Automation (Meta WhatsApp Business Cloud API) ---------------
WHATSAPP_ENABLED=true
# true = test mode: nothing is sent, messages are only recorded as "simulated"
WHATSAPP_SIMULATED=false

# --- Meta WhatsApp Cloud API -----------------------------------------------
# Use a permanent System User token (Meta Business Settings > System users); temporary tokens expire.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_API_VERSION=v21.0
# Required for the Meta webhook handshake. Use a long random value; there is no default.
META_WA_WEBHOOK_VERIFY_TOKEN=

# --- Admin login (required) -----------------------------------------------
# The dashboard refuses to sign in until both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_ROLE=Operations Dispatcher
# Signs login tokens. Leave empty to generate one per run (everyone is signed out on restart).
AUTH_SECRET=
AUTH_SESSION_HOURS=8
AUTH_REMEMBER_DAYS=30

# --- Brand, locale and links --------------------------------------------------
COMPANY_NAME=ExtraHand
WEBSITE_URL=https://extrahand.in
# Logo used on posters (file in frontend/public or a full URL)
BRAND_LOGO_URL=/extrahand_full_logo_transparent.png
BOOKING_URL=https://extrahand.in/book
OFFERS_URL=https://extrahand.in/offers
# {task_id} is replaced with the ticket id
TASK_URL_TEMPLATE=https://extrahand.in/tasks/{task_id}
# Placeholders: {name}, {company}, {link}
BULK_MESSAGE_TEMPLATE=Namaste {name}! {company} is offering an exclusive discount on all home maintenance, plumbing, and electrical services this week. Book your expert partner now at {link}. Reply STOP to unsubscribe.
DEFAULT_COUNTRY_CODE=+91
PHONE_LOCAL_DIGITS=10
CURRENCY_WORD=rupees
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
PORT=8050
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:3050,http://127.0.0.1:3050,http://localhost:5173,http://127.0.0.1:5173

# --- Marketing agent (OpenRouter) --------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_TIMEOUT_SECONDS=8
# Image model that draws new poster artwork on each regenerate (leave empty to only use the photo library)
POSTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
POSTER_IMAGE_ASPECT_RATIO=4:3
POSTER_IMAGE_TIMEOUT_SECONDS=120
# Draw AI artwork automatically for each registered festival's poster
POSTER_AUTO_ARTWORK=true

# All-India "Find Festivals" button: the GPT-OSS-20B agent (uses OPENROUTER_API_KEY) reads Drik Panchang
# and picks the major festivals; every result waits for admin approval.
FESTIVAL_MODEL=openai/gpt-oss-20b
# IMD Rashtriya Panchang page used to verify the dates (leave empty to skip the check)
FESTIVAL_VERIFY_URL=
FESTIVAL_SEARCH_MONTHS=3
FESTIVAL_SEARCH_EVERY_MONTHS=3
FESTIVAL_MAX_PER_MONTH=8

# City festivals are registered by hand. Marketing data (regions, festivals, posters)
# is stored in the main DATABASE_URL database.
# --- Posters and WhatsApp banners: Azure Blob Storage (voice audio stays on disk) ---
# MEDIA_STORAGE: "auto" (Azure when connection string is set, else local folders), "azure", or "local"
MEDIA_STORAGE=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=extrahand-media

# Generated poster images (defaults to backend/database/posters)
# MARKETING_POSTERS_DIR=
# Festival photos used on posters; defaults to frontend/public/posters
# POSTER_ASSETS_DIR=
MARKETING_DEFAULT_STATE=Telangana
MARKETING_DEFAULT_DISCOUNT=20
# Regions (All-India and the cities): backend/marketing/data/regions.json


# --- Server (run.py) -----------------------------------------------------------
HOST=127.0.0.1
PORT=5074
RELOAD=true

# Public address of the backend server (used for Vobiz callbacks, Meta webhooks, etc.)
PUBLIC_BASE_URL=https://backend.intelligence.extrahand.in

# Allowed CORS origins
CORS_ORIGINS=https://intelligence.extrahand.in,http://intelligence.extrahand.in,https://backend.intelligence.extrahand.in,http://localhost:3074,http://127.0.0.1:3074

# Cookie domain for cross-subdomain authentication
SESSION_COOKIE_DOMAIN=.extrahand.in

# Task-Seeding Agent (Advertisement > Task Seeding): fixed https address of this backend for the tracked
# Book Now link. Empty = the button opens extrahand.in/book directly and link clicks are not counted.
TASK_SEEDING_LINK_BASE=https://backend.intelligence.extrahand.in
