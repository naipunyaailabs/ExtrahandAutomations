# For local runs (python agent.py dev). The deployed agent gets these from the LiveKit Cloud agent environment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
OPENROUTER_API_KEY=
# The backend's public address, reachable from LiveKit Cloud (it serves /api/handoff/...).
BACKEND_BASE_URL=https://your-backend.example.com
# The agent name the LiveKit SIP dispatch rule sends calls to.
HANDOFF_AGENT_NAME=extrahand-ivr-handoff
