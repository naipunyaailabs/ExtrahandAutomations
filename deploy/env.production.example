# =============================================================================================================
# ExtraHand Intelligence Platform: settings for the Docker server.
#   cp deploy/env.production.example .env     (in the repo folder on the server, next to docker-compose.yml)
#   chmod 600 .env                            then fill in every CHANGE_ME
# The app refuses to start while anything critical is missing, and its log says what (docker compose logs app).
# Secrets:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================================================

# --- Server ------------------------------------------------------------------------------------------------
# The public HTTPS address of the backend API (used for Vobiz callbacks, Meta webhooks, Book Now tracking).
PUBLIC_BASE_URL=https://backend.intelligence.extrahand.in
PORT=5074
APP_PORT=5074
FRONTEND_PORT=3074
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.extrahand.in
CORS_ORIGINS=https://intelligence.extrahand.in,http://intelligence.extrahand.in,https://backend.intelligence.extrahand.in,http://localhost:3074,http://127.0.0.1:3074

# --- Database (Production Remote PostgreSQL Server) ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://adminuser:Admin%4012345,.@200.141.7.100:5437/Extrahand

# --- Dashboard login: one admin ----------------------------------------------------------------------------
# The login page opens first; only this account can sign in. Password: at least 12 characters.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin
# Signs the login cookie: at least 32 random characters (the secret command above).
SESSION_SECRET=CHANGE_ME

# --- ExtraHand data ----------------------------------------------------------------------------------------
EXTRAHAND_MODE=live
EXTRAHAND_EMAIL=CHANGE_ME
EXTRAHAND_PASSWORD=CHANGE_ME
# EXTRAHAND_MAIN_BASE_URL=https://extrahand-main-admin-server.backend.extrahand.in/api/v1
# EXTRAHAND_TASK_BASE_URL=https://extrahand-task-service.backend.extrahand.in

# --- WhatsApp (Meta Cloud API) -----------------------------------------------------------------------------
# Webhook in the Meta app: https://<PUBLIC_BASE_URL>/api/whatsapp/webhook with META_WA_WEBHOOK_VERIFY_TOKEN.
META_APP_ID=
META_APP_SECRET=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=
# Task-Seeding Agent: Book Now links go through this address so clicks are counted. Same as PUBLIC_BASE_URL.
TASK_SEEDING_LINK_BASE=https://CHANGE_ME.example.com

# --- Posters and WhatsApp banners: Azure Blob Storage ----------------------------------------------------
# Azure portal > Storage account > Access keys > Connection string. The container is created private by the app;
# images are served through this server's own addresses. Leave empty to keep them in the /data volume instead.
# (Voice call audio always stays on the server's disk.)
MEDIA_STORAGE=auto
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=extrahand-media

# --- Phone line (Vobiz) ------------------------------------------------------------------------------------
TELEPHONY_PROVIDER=vobiz
VOBIZ_AUTH_ID=CHANGE_ME
VOBIZ_AUTH_TOKEN=CHANGE_ME
VOBIZ_FROM_NUMBER=CHANGE_ME
VOBIZ_VALIDATE_SIGNATURE=true

# --- Telugu voice (Sarvam) ---------------------------------------------------------------------------------
SARVAM_API_KEY=CHANGE_ME
AUDIO_URL_SECRET=CHANGE_ME

# --- AI (posters, festival finder, pricing agent) ----------------------------------------------------------
OPENROUTER_API_KEY=

# --- Hand-off to Maya (optional: leave both empty and the keypad outcome is used) ---------------------------
HANDOFF_SIP_URI=
HANDOFF_SECRET=

# --- Pricing agent (optional) ------------------------------------------------------------------------------
# The key the ExtraHand app sends as X-API-Key on /api/pricing/v1/*; until set, that route answers 503.
PRICING_API_KEY=
# SearXNG / Maps scraper: leave empty inside Docker unless they run in the same compose network
# (then e.g. http://searxng:8080). Empty = public search engines through the ddgs library.
SEARXNG_URL=
GMAPS_SCRAPER_URL=

# --- Optional ----------------------------------------------------------------------------------------------
# AUTO_DISPATCH=true
# CALLING_AGENT_ACTIVE=false
