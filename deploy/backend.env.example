# Backend settings for the VPS. Copy to /etc/extrahand/backend.env (owner root, mode 600) and fill in every CHANGE_ME.
# With APP_ENV=production the backend refuses to start while anything critical is missing, and says what.

APP_ENV=production
TRUST_PROXY_HEADERS=true
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=

# --- Dashboard login ---------------------------------------------------------------------------------------
# Make a user:   cd /opt/extrahand/backend && /opt/extrahand/venv/bin/python -m app.tools.add_user you@company.com
# It prints a DASHBOARD_USERS='[...]' line: paste it here (repeat the command with DASHBOARD_USERS set to add more).
# Secret:        python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_USERS=
SESSION_SECRET=CHANGE_ME

# --- Database (the VPS SQL Server; each service keeps its tables in its own schema) -------------------------
DATABASE_URL=CHANGE_ME
# e.g. mssql+pyodbc://extrahand_app:PASSWORD@127.0.0.1:1433/extrahand?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- ExtraHand data ----------------------------------------------------------------------------------------
EXTRAHAND_MODE=live
EXTRAHAND_EMAIL=CHANGE_ME
EXTRAHAND_PASSWORD=CHANGE_ME

# --- Phone line (Vobiz) ------------------------------------------------------------------------------------
TELEPHONY_PROVIDER=vobiz
VOBIZ_AUTH_ID=CHANGE_ME
VOBIZ_AUTH_TOKEN=CHANGE_ME
VOBIZ_FROM_NUMBER=CHANGE_ME
VOBIZ_VALIDATE_SIGNATURE=true
# The https address of this server, exactly as Vobiz reaches it (no trailing slash).
PUBLIC_BASE_URL=https://ivr.example.com

# --- Telugu voice (Sarvam) and the files it makes ----------------------------------------------------------
SARVAM_API_KEY=CHANGE_ME
IVR_AUDIO_DIR=/var/lib/extrahand/ivr_audio
# Secret:        python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIO_URL_SECRET=CHANGE_ME

# --- Hand-off to Maya (optional: leave both empty and the keypad outcome is used) ---------------------------
# HANDOFF_SIP_URI is LiveKit Cloud > Project settings > SIP URI (sip:<id>.sip.livekit.cloud). HANDOFF_SECRET is
# another random secret (same command as above); it only signs the per-call tokens, the agent never needs it.
HANDOFF_SIP_URI=
HANDOFF_SECRET=

# --- Pricing agent (competitor prices -> recommended price per service and area) ----------------------------
# The key the ExtraHand app team sends as the X-API-Key header on /api/pricing/v1/*. That route has no dashboard
# login, so until this is set it answers 503.
# Key:           python -c "import secrets; print(secrets.token_urlsafe(32))"
PRICING_API_KEY=CHANGE_ME
# The agent also needs OPENROUTER_API_KEY (below). SearXNG and the Maps scraper run beside the backend: see
# deploy/pricing-tools/. Leave a URL empty to go without it (public engines through the ddgs library / web reviews only).
SEARXNG_URL=http://127.0.0.1:8888
GMAPS_SCRAPER_URL=http://127.0.0.1:8080
# PRICING_SEARCH_ENGINES=yahoo,brave,startpage,duckduckgo   # ddgs engines in the order tried when SEARXNG_URL is empty
# PRICING_SCHEDULER_ENABLED=false   # true by default: a run starts by itself when the last one is older than the refresh days
# The agent reads pages with FREE OpenRouter models (a few are tried in turn; the list lives in app/config.py). To use a paid
# one instead, set e.g. PRICING_LLM_MODELS=google/gemini-2.5-flash
# PRICING_LLM_MODELS=

# --- Posters and WhatsApp banners: Azure Blob Storage ----------------------------------------------------
# Azure portal > Storage account > Access keys > Connection string.
MEDIA_STORAGE=azure
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME
AZURE_STORAGE_CONTAINER=extrahand-media

# --- Optional ----------------------------------------------------------------------------------------------
# AUTO_DISPATCH=true
# META_WA_PHONE_NUMBER_ID=
# META_WA_ACCESS_TOKEN=
# META_WA_WEBHOOK_VERIFY_TOKEN=
# OPENROUTER_API_KEY=   # required by the pricing agent (reads competitor pages)
