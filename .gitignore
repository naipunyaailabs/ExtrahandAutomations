# =============================================================================
# Git Ignore Rules for ExtraHand Intelligence Platform
# =============================================================================

# Environment & Secrets
.env
backend/.env
frontend/.env
voice-handoff/.env
*.env
*.env.*
!*.env.example

# Python
backend/.venv/
voice-handoff/.venv/
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Databases & Backups
backend/database/*.db
backend/database/*.db-*
*.sqlite3

# Node / Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.npm
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime Logs & Binaries
*.log
backend/*.log
backend/cloudflared.exe
*.exe

# Local Generated Audio & Banner Caches (Azure Blob Storage is used instead)
backend/database/ivr_audio/*.wav
backend/database/whatsapp_banners/*
backend/database/posters/*

# OpenWA WhatsApp gateway (separate project, cloned locally)
openwa-gateway/
